<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_inherit_sla" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sla</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                <field name="stage_entered_date" readonly="1"/>
                <field name="sla_deadline" readonly="1"/>
                <field name="sla_notified" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
